{
	"name": "@pananfly/pi-im",
	"version": "0.1.3",
	"type": "module",
	"license": "MIT",
	"description": "Pi 双通道 IM 插件:飞书 + Telegram,共享主会话,远程驱动 coding agent",
	"keywords": [
		"pi",
		"pi-coding-agent",
		"pi-extension",
		"coding-agent",
		"telegram",
		"telegram-bot",
		"feishu",
		"lark",
		"im",
		"bot",
		"chatops",
		"remote-control"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pananfly/pi-im.git"
	},
	"homepage": "https://github.com/pananfly/pi-im#readme",
	"bugs": {
		"url": "https://github.com/pananfly/pi-im/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"pi": {
		"extensions": [
			"./index.js"
		]
	},
	"files": [
		"index.js",
		"dist",
		"scripts",
		"README.md",
		"README.en.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "biome check . && tsc --noEmit",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run check && npm run test && npm run build"
	},
	"dependencies": {
		"@larksuiteoapi/node-sdk": "1.72.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.83.0 <2",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@earendil-works/pi-coding-agent": "1.1.0",
		"@types/node": "24.12.4",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
